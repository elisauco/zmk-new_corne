#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&soft_off { hold-time-ms = <2000>; };

&mt { flavor = "tap-preferred"; };

/ {
    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };

        caps {
            bindings = <&kp CAPS>;
            key-positions = <14 26>;
        };

        game_mode_toggle {
            bindings = <&tog 5>;
            key-positions = <17 3 15>;
            timeout-ms = <2000>;
        };
    };

    macros {
        double_0: double_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;
            label = "DOUBLE_0";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "ALPHA";
            bindings = <
&none  &kp Q             &kp W        &kp E           &kp R           &kp T                      &none         &kp Y        &kp U            &kp I            &kp O        &kp P                 &none
&none  &mt LEFT_SHIFT A  &mt LCTRL S  &mt LEFT_GUI D  &mt LEFT_ALT F  &kp G               &none  &none  &none  &kp H        &mt RIGHT_ALT J  &mt RIGHT_GUI K  &mt RCTRL L  &mt RIGHT_SHIFT SEMI  &none
&none  &kp Z             &kp X        &kp C           &kp V           &kp B      &none           &none         &kp N        &kp M            &kp COMMA        &kp DOT      &kp FSLH              &none
                                      &lt 2 ESCAPE    &lt 4 SPACE     &lt 1 TAB                                &lt 3 ENTER  &kp BACKSPACE    &kp DELETE
            >;
        };

        Num {
            bindings = <
&none  &trans  &trans  &trans  &trans  &trans                  &none         &kp SLASH     &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS   &none
&none  &trans  &trans  &trans  &trans  &trans           &none  &none  &none  &kp ASTERISK  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS    &none
&none  &trans  &trans  &trans  &trans  &trans  &none           &none         &trans        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD  &none
                       &trans  &trans  &trans                                &kp ENTER     &kp KP_NUMBER_0  &double_0
            >;

            label = "NUM";
        };

        func {
            bindings = <
&none  &trans  &trans  &trans  &trans  &trans                    &trans          &trans  &kp F7  &kp F8  &kp F9  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &kp F4  &kp F5  &kp F6  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans            &trans          &trans  &kp F1  &kp F2  &kp F3  &trans  &none
                       &trans  &trans  &trans                                    &trans  &trans  &trans
            >;

            label = "FUN";
        };

        symb {
            bindings = <
&none  &kp LEFT_BRACE        &kp AMPERSAND    &kp EQUAL       &kp TILDE  &kp RIGHT_BRACE                        &none         &trans         &trans  &trans  &trans  &trans  &none
&none  &kp LEFT_PARENTHESIS  &kp DOLLAR       &kp PERCENT     &kp CARET  &kp RIGHT_PARENTHESIS           &none  &none  &none  &kp PIPE       &trans  &trans  &trans  &trans  &none
&none  &kp LEFT_BRACKET      &kp EXCLAMATION  &kp AT_SIGN     &kp POUND  &kp RIGHT_BRACKET      &none           &none         &kt BACKSLASH  &trans  &trans  &trans  &trans  &none
                                              &kp UNDERSCORE  &kp SQT    &kp DOUBLE_QUOTES                                    &trans         &trans  &trans
            >;

            label = "SYMB";
        };

        nav_md_ms {
            bindings = <
&none  &trans        &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp C_VOLUME_UP                    &none         &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans  &none
&none  &trans        &trans        &trans        &trans        &kp C_VOLUME_DOWN           &none  &none  &none  &kp LEFT        &kp DOWN        &kp UP_ARROW  &kp RIGHT        &trans  &none
&none  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0       &none           &none         &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &none
                                   &trans        &trans        &trans                                           &mkp RCLK       &mkp LCLK       &mkp MCLK
            >;

            label = "NAV+MD";
        };

        game_mode {
            bindings = <
&none  &kp TAB         &kp Q  &kp W       &kp E      &kp R                  &none         &kp F9     &kp I  &none  &none  &none  &none
&none  &kp LEFT_SHIFT  &kp A  &kp S       &kp D      &kp F           &none  &none  &none  &kp F5     &kp J  &none  &none  &none  &none
&none  &kp LCTRL       &kp Z  &kp X       &kp C      &none  &none           &none         &none      &kp M  &none  &none  &none  &none
                              &kp ESCAPE  &kp SPACE  &mo 6                                &kp ENTER  &none  &none
            >;

            label = "GAME";
        };

        game_mode_2 {
            bindings = <
&none  &kp NUMBER_6  &kp NUMBER_7  &kp N8        &kp N9        &kp N0                        &none         &trans  &trans  &trans  &trans  &trans  &none
&none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5           &none  &none  &none  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans        &trans        &trans        &trans        &trans        &none           &none         &trans  &trans  &trans  &trans  &trans  &none
                                   &trans        &trans        &trans                                      &trans  &trans  &trans
            >;

            label = "GAME+";
        };
    };
};
