#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&soft_off { hold-time-ms = <2000>; };

&mt { flavor = "tap-preferred"; };

&lt {
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };

        caps {
            bindings = <&kp LCTRL>;
            key-positions = <14 26>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&none  &kp Q             &kp W        &kp E           &kp R           &kp T                      &none         &kp Y        &kp U            &kp I            &kp O        &kp P                 &none
&mo 5  &mt LEFT_SHIFT A  &mt LCTRL S  &mt LEFT_GUI D  &mt LEFT_ALT F  &kp G               &none  &none  &none  &kp H        &mt RIGHT_ALT J  &mt RIGHT_GUI K  &mt RCTRL L  &mt RIGHT_SHIFT SEMI  &kp SQT
&none  &kp Z             &kp X        &kp C           &kp V           &kp B      &none           &none         &kp N        &kp M            &kp COMMA        &kp DOT      &kp FSLH              &none
                                      &lt 3 ESCAPE    &lt 2 SPACE     &lt 1 TAB                                &lt 4 ENTER  &kp BACKSPACE    &kp DELETE
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        Num {
            bindings = <
&none  &trans  &trans  &trans  &trans  &trans                  &none         &kp SLASH     &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS   &none
&none  &trans  &trans  &trans  &trans  &trans           &none  &none  &none  &kp ASTERISK  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS    &trans
&none  &trans  &trans  &trans  &trans  &trans  &none           &none         &trans        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD  &none
                       &trans  &trans  &trans                                &kp ENTER     &kp BACKSPACE    &kp KP_NUMBER_0
            >;

            label = "NUM";
        };

        Navigation {
            bindings = <
&none  &trans  &trans  &trans  &trans  &trans                  &none         &trans    &trans    &trans  &trans     &trans  &none
&none  &trans  &trans  &trans  &trans  &trans           &none  &none  &none  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&none  &trans  &trans  &trans  &trans  &trans  &none           &none         &trans    &trans    &trans  &trans     &trans  &none
                       &trans  &trans  &trans                                &trans    &trans    &trans
            >;
        };

        func {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans          &trans  &kp F7  &kp F8  &kp F9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &kp F4  &kp F5  &kp F6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans          &trans  &kp F1  &kp F2  &kp F3  &trans  &trans
                        &trans  &trans  &trans                                    &trans  &trans  &trans
            >;

            label = "FUN";
        };

        symb {
            bindings = <
&none   &kp LEFT_BRACE        &kp AMPERSAND    &kp EQUAL    &kp TILDE       &kp RIGHT_BRACE                        &none         &trans  &trans  &trans  &trans  &trans  &none
&trans  &kp LEFT_PARENTHESIS  &kp DOLLAR       &kp PERCENT  &kp CARET       &kp RIGHT_PARENTHESIS           &none  &none  &none  &trans  &trans  &trans  &trans  &trans  &trans
&none   &kp LEFT_BRACKET      &kp EXCLAMATION  &kp AT_SIGN  &kp POUND       &kp RIGHT_BRACKET      &none           &none         &trans  &trans  &trans  &trans  &trans  &none
                                               &kp PIPE     &kp UNDERSCORE  &kp BACKSLASH                                        &trans  &trans  &trans
            >;

            label = "SYMB";
        };

        media_mouse {
            bindings = <
&none   &trans        &trans        &trans        &trans        &kp C_VOLUME_UP                    &none         &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans  &none
&trans  &trans        &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp C_VOLUME_DOWN           &none  &none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&none   &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0       &none           &none         &trans          &trans          &trans        &trans           &trans  &none
                                    &trans        &trans        &trans                                           &mkp RCLK       &mkp LCLK       &mkp MCLK
            >;

            label = "MOUSE+MD";
        };
    };
};
